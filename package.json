{
  "name": "@local/dsh-win-mingw",
  "version": "0.1.0",
  "private": true,
  "description": "Runs the Windows DSH shell tool in Git Bash (the MinGW64 shell bundled with Git for Windows) instead of PowerShell.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./executor": "./executor.js",
    "./prompt": "./prompt.js",
    "./mingw": "./mingw.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "executor.js",
    "prompt.js",
    "mingw.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-bash-sandbox": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
